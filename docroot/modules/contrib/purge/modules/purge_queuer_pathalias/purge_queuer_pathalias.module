<?php

/**
 * @file
 * Queues URL invalidations when path aliases are created, changed or deleted.
 *
 * Drupal 11.1 and later run the hooks in
 * \Drupal\purge_queuer_pathalias\Hook\PathAliasHooks instead; these wrappers
 * only run on older core versions.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\purge_queuer_pathalias\Hook\PathAliasHooks;

/**
 * Implements hook_ENTITY_TYPE_insert() for path_alias entities.
 */
#[LegacyHook]
function purge_queuer_pathalias_path_alias_insert(EntityInterface $entity) {
  (new PathAliasHooks(\Drupal::service('purge_queuer_pathalias.queuer'), \Drupal::service('logger.factory')))->pathAliasInsert($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for path_alias entities.
 */
#[LegacyHook]
function purge_queuer_pathalias_path_alias_update(EntityInterface $entity) {
  (new PathAliasHooks(\Drupal::service('purge_queuer_pathalias.queuer'), \Drupal::service('logger.factory')))->pathAliasUpdate($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for path_alias entities.
 */
#[LegacyHook]
function purge_queuer_pathalias_path_alias_delete(EntityInterface $entity) {
  (new PathAliasHooks(\Drupal::service('purge_queuer_pathalias.queuer'), \Drupal::service('logger.factory')))->pathAliasDelete($entity);
}

<?php

/**
 * @file
 * Administrative interface for Purge.
 *
 * Drupal 11.1 and later run the hooks in \Drupal\purge_ui\Hook instead; these
 * wrappers only run on older core versions.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\purge_ui\Hook\PurgeUiThemeHooks;

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function purge_ui_theme() {
  return (new PurgeUiThemeHooks())->theme();
}

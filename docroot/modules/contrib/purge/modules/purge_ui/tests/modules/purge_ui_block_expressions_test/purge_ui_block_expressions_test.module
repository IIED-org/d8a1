<?php

/**
 * @file
 * Test implementation of hook_purge_ui_block_expressions_alter().
 *
 * Drupal 11.1 and later run the hook in
 * \Drupal\purge_ui_block_expressions_test\Hook instead; this wrapper only runs
 * on older core versions.
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\purge_ui_block_expressions_test\Hook\PurgeUiBlockExpressionsTestHooks;

/**
 * Implements hook_purge_ui_block_expressions_alter().
 */
#[LegacyHook]
function purge_ui_block_expressions_test_purge_ui_block_expressions_alter(array &$expressions, array $config): void {
  (new PurgeUiBlockExpressionsTestHooks(\Drupal::state()))->purgeUiBlockExpressionsAlter($expressions, $config);
}

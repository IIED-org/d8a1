<?php

/**
 * @file
 * Hook implementations for the purge module.
 *
 * Drupal 11.1 and later run the hooks in \Drupal\purge\Hook instead; these
 * wrappers only run on older core versions.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\purge\Hook\PurgeFormHooks;

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function purge_form_system_performance_settings_alter(&$form, FormStateInterface $form_state, $form_id) {
  (new PurgeFormHooks())->formSystemPerformanceSettingsAlter($form, $form_state, $form_id);
}

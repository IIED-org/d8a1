<?php

/**
 * @file
 * Install, update and uninstall functions for the Leaflet Mapbox module.
 */

/**
 * Migrate the single-map settings to the multiple maps structure.
 */
function leaflet_mapbox_update_10201() {
  $config = \Drupal::configFactory()->getEditable('leaflet_mapbox.settings');

  // Already migrated.
  if ($config->get('maps') !== NULL) {
    return t('Leaflet Mapbox settings already use the multiple maps structure.');
  }

  $maps = [];
  // Only create a map entry when the site actually configured one. The
  // 'default' key keeps the original 'leaflet-mapbox' map id, so existing
  // views and field displays continue to work.
  if ($config->get('label') || $config->get('token')) {
    $maps['default'] = [
      'label' => $config->get('label') ?? '',
      'api_version' => $config->get('api_version') ?? '4',
      'code' => $config->get('code') ?? '',
      'style_url' => $config->get('style_url') ?? '',
      'token' => $config->get('token') ?? '',
      'zoomlevel' => (int) ($config->get('zoomlevel') ?? 2),
      'description' => $config->get('description') ?? '',
    ];
  }

  $config->setData(['maps' => $maps])->save(TRUE);

  return t('Leaflet Mapbox settings migrated to the multiple maps structure.');
}

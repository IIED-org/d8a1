<?php

/**
 * @file
 * Provides Leaflet integration with Mapbox.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\leaflet_mapbox\Hook\LeafletMapboxHooks;

/**
 * Implements hook_leaflet_map_info().
 */
#[LegacyHook]
function leaflet_mapbox_leaflet_map_info() {
  return \Drupal::service(LeafletMapboxHooks::class)->leafletMapInfo();
}
